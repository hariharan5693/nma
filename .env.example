# ─────────────────────────────────────────────────────────────────────────────
# NMA (New Market Onboarding) — environment template
# Copy to .env and fill in the secrets. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── LangSmith (tracing / observability) ──
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://langsmith.aiplat-dev.aws.private-pmideep.biz/api/v1
LANGSMITH_API_KEY=lsv2_pt_your_key_here
LANGSMITH_PROJECT=new_market_onboarding

# ── LiteLLM (LLM access, OpenAI-compatible /v1 endpoint) ──
# NOTE: must end with /v1 (NOT /bedrock)
OPENAI_API_KEY=sk-your_litellm_key_here
OPENAI_BASE_URL=https://litellm.aiplat-dev.aws.private-pmideep.biz/v1

# ── Model selection ──
NMA_LLM_MODEL=bedrock/us.anthropic.claude-sonnet-4-6
NMA_LLM_MAX_TOKENS=8192
NMA_LLM_TEMPERATURE=0

# ── PMI internal certs: local runs typically need SSL verification off ──
LANGCHAIN_VERIFY_SSL=false
NMA_VERIFY_SSL=false

# ── Mapping thresholds ──
NMA_CONFIDENCE_THRESHOLD=0.80

# ── Tenant / deploy identity (used only at deploy/registration time) ──
# Confirmed tenant: mmiana-dev  (see .kiro/steering/nma-deployment.md)
NMA_TENANT_NAME=mmiana-dev
